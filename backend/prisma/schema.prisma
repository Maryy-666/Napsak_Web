generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  applications        Application[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
}

model Application {
  id        Int               @id @default(autoincrement())
  userId    Int
  program   String
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  category  String?
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Event {
  id             Int       @id @default(autoincrement())
  title          String
  description    String?
  category       String?
  location       String?
  status         String?   @default("Yaklaşan")
  image          String?
  capacity       Int?
  targetAudience String?
  startDate      DateTime
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  eventApplications EventApplication[]
}

model EventApplication {
  id         Int      @id @default(autoincrement())
  eventId    Int
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fullName   String
  email      String
  phone      String?
  city       String?
  school     String?
  department String?
  grade      String?
  note       String?
  status     String   @default("Beklemede")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Activity {
  id                   Int      @id @default(autoincrement())
  type                 String   @default("polaroid")
  title                String
  category             String   @default("Genel")
  team                 String   @default("N'apsak Ekibi")
  status               String   @default("Devam Eden")
  date                 String?
  location             String?
  summary              String?
  participantCount     Int      @default(0)
  image                String?
  rotation             String?  @default("-rotate-1")
  pinColor             String?  @default("text-[#0A5C3A]")
  noteBg               String?  @default("bg-white")
  borderColor          String?  @default("border-[#DDE7E1]")
  badgeBg              String?  @default("bg-[#0A5C3A]")
  badgeText            String?  @default("text-white")
  mottoText            String?
  tagText              String?
  tapeColor            String?
  tapeRotation         String?
  youthStickerIconName String?
  stickerBadgeBg       String?
  objectives           String[] @default([])
  impactMetrics        String?
  outcomes             String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Member {
  id          Int      @id @default(autoincrement())
  externalId  String   @unique
  name        String
  initials    String
  primaryTeam String
  primaryRole String
  memberships Json
  isPresident Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Team {
  id                   Int      @id @default(autoincrement())
  externalId           String   @unique
  slug                 String   @unique
  title                String
  shortDescription     String
  iconName             String   @default("cpu")
  bgImage              String
  about                String
  focusAreas           String[] @default([])
  whatWeDo             String[] @default([])
  structure            String
  featuredSectionImage String?
  galleryTitle         String?
  gallery              Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Report {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Magazine {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
